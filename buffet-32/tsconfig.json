// tsconfig.json
{
  "compilerOptions": {
    // ... otras opciones que ya tengas
    "baseUrl": ".", // <--- ¡MUY IMPORTANTE! Esto define la base para resolver los "paths"
    "paths": {
      "@/*": [
        "./src/*"
      ] // <--- ¡MUY IMPORTANTE! Esto mapea "@/" a la carpeta "src/"
      // Si tienes otros alias como "@components/*", también deberían estar aquí
      // "@/components/*": ["./src/app/components/*"]
    },
    // ... otras opciones como "jsx", "lib", "moduleResolution"
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
